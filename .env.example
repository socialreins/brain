# Local development values. Copy to .env (gitignored); see README for every variable.
DATABASE_URL=postgres://brain:brain@localhost:5432/socialreins_brain
BRAIN_URL=http://localhost:8080
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Required: encrypts platform tokens at rest. Generate one: openssl rand -base64 32
ENCRYPTION_KEY=
# No mail server locally: sign-in links are written to the log.
MAIL_LOG=true
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=SocialReins <login@example.com>
# REGISTRATION_DISABLED=false
# With REGISTRATION_DISABLED=true, the one new email allowed to sign up besides invited ones:
# OWNER_EMAIL=you@example.com
# Optional Google sign-in (both or neither). Redirect URI: {BRAIN_URL}/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
