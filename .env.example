# Local development values. Copy to .env (gitignored); see README for every variable.
DATABASE_URL=postgres://brain:brain@localhost:5432/socialreins_brain
BRAIN_URL=http://localhost:8080
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# No mail server locally: sign-in links are written to the log (MAIL_LOG=true hides the warning).
MAIL_LOG=true
