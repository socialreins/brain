# Local development values. Copy to .env (gitignored); see README for every variable.
DATABASE_URL=postgres://brain:brain@localhost:5432/socialreins_brain
BRAIN_URL=http://localhost:8080
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Required: encrypts platform tokens at rest. Generate one: openssl rand -base64 32
ENCRYPTION_KEY=
# No mail server locally: sign-in links are written to the log.
MAIL_LOG=true
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=SocialReins <login@example.com>
# REGISTRATION_DISABLED=false
# Only these email domains and addresses may create accounts (unset: any); anyone else who signs up
# goes on the waitlist. Invited emails and OWNER_EMAIL are exempt:
# SIGNUP_DOMAINS=example.com,example.org,jane@example.net
# With REGISTRATION_DISABLED=true, the one new email allowed to sign up besides invited ones:
# OWNER_EMAIL=you@example.com
# Optional Google sign-in (both or neither). Redirect URI: {BRAIN_URL}/auth/google/callback
# These also turn on connecting YouTube channels; add {BRAIN_URL}/connect/youtube/callback too.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional Threads connect (both). Redirect URI: {BRAIN_URL}/connect/threads/callback
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# Optional TikTok connect (both). Redirect URI: {BRAIN_URL}/connect/tiktok/callback
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Optional LinkedIn connect (both). Redirect URI: {BRAIN_URL}/connect/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Optional X connect (both). Redirect URI: {BRAIN_URL}/connect/x/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Optional Facebook and Instagram connect (both). Redirect URI: {BRAIN_URL}/connect/meta/callback
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
# Optional Meta webhook: any secret string, also typed into the Meta app. Callback URL:
# {BRAIN_URL}/webhooks/meta (signed with META_APP_SECRET)
# META_WEBHOOK_VERIFY_TOKEN=
# Optional Cloudflare Turnstile captcha on sign-in links and contact (both or neither):
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Optional contact form: where POST /v1/contact mails messages.
# CONTACT_TO=you@example.com
# Post media is kept in ./media while a post publishes. Or an S3-compatible bucket (all four or
# none; S3_REGION defaults to auto, for Cloudflare R2):
# MEDIA_DIR=./media
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Optional: comma-separated emails that may use the admin console (/v1/admin/*). Sign-up rules
# saved there replace REGISTRATION_DISABLED and SIGNUP_DOMAINS.
# ADMIN_EMAILS=you@example.com
# Optional, only during app review: GET /review-login/<token> signs a reviewer into a demo account.
# REVIEW_LOGIN_TOKEN=
